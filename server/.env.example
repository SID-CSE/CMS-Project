# LOCAL COPY: server/.env
# DEPLOYMENT LOCATION: Render service -> Environment
DB_URL=jdbc:mysql://localhost:3306/Contify?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=

# Use a long random value in production (at least 32 characters)
JWT_SECRET=

# One or more comma-separated browser origins
FRONTEND_URL=http://localhost:5173

# Local run command selects the dev profile; Render must use SPRING_PROFILES_ACTIVE=prod
# Render injects PORT; 9090 is the local fallback
PORT=9090

# Single browser origin used in password reset links
FRONTEND_BASE_URL=http://localhost:5173

MAIL_ENABLED=false
MAIL_DEV_EXPOSE_VERIFICATION_URL=true
MAIL_VERIFICATION_EXPIRATION_MINUTES=30
MAIL_VERIFICATION_RESEND_SECONDS=60
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com

GOOGLE_CLIENT_ID=
# Get from Google Cloud Console -> APIs & Services -> Credentials.

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# CLOUDINARY_API_KEY and CLOUDINARY_API_SECRET belong only in the backend environment.

KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TASK_TOPIC=contify.task-events
